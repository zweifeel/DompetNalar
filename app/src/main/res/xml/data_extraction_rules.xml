<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <!-- Cegah kebocoran sesi login, PIN keamanan, dan token kredensial developer melintasi reinstall via Android Cloud Backup -->
        <exclude domain="sharedpref" path="finsmart_session_prefs.xml"/>
        <exclude domain="sharedpref" path="finsmart_auth_prefs.xml"/>
        <exclude domain="sharedpref" path="finsmart_prefs.xml"/>
        <exclude domain="sharedpref" path="finsmart_theme_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="finsmart_session_prefs.xml"/>
        <exclude domain="sharedpref" path="finsmart_auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>

