<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <!-- Cegah kebocoran sesi login, PIN keamanan, dan token kredensial developer melintasi reinstall via Android Auto Backup -->
    <exclude domain="sharedpref" path="finsmart_session_prefs.xml"/>
    <exclude domain="sharedpref" path="finsmart_auth_prefs.xml"/>
    <exclude domain="sharedpref" path="finsmart_prefs.xml"/>
    <exclude domain="sharedpref" path="finsmart_theme_prefs.xml"/>
</full-backup-content>

